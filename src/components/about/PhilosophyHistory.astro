---
import Container from '../shared/Container.astro';
import Timeline from './Timeline.astro';
import { Image } from 'astro:assets';
import philosophyImage from '../../assets/img/about-page-img-06.jpg';

const timelineEvents = [
  {
    year: "2008",
    title: "Inicios",
    description: "Pedro empezó en el rubro de mueblería en Ecuador",
    isFirst: true
  },
  {
    year: "2022",
    title: "Consolidándose en Chile",
    description: "Trabajando en varios projectos de interior"
  },
  {
    year: "2026",
    title: "El inicio",
    description: "Se consolida la empresa de mueblería propia"
  }
];
---

<section class="py-24">
  <Container>
    <div class="grid lg:grid-cols-2 gap-20 lg:gap-32 items-start">
      {/* Philosophy Column */}
      <div class="space-y-8">
        <div class="flex items-center gap-4">
          <div class="h-[1px] w-12 bg-primary" />
          <h2 class="text-sm font-bold uppercase tracking-[0.3em] text-primary">Philosophy</h2>
        </div>
        <h3 class="text-3xl font-black leading-tight">"Creamos muebles que no solo ocupan un espacio, sino que acompañan la vida cotidiana"</h3>
        <p class="text-slate-600 dark:text-slate-400 leading-loose">
          En muebles Pilligua creemos que nuestra valor está en  <strong>realizar lo que el cliente desea </strong>— llevando a realidad sus ideas satisfactoriamente.
        </p>
        <p class="text-slate-600 dark:text-slate-400 leading-loose">
          Los muebles son honestos, con buenas terminacioens y pensadas para durar.
        </p>
        <div class="pt-4">
         <Image
        src={philosophyImage}
            alt="Mueble creado por la empresa"
       widths={[240, 540, 720, philosophyImage.width]}
  sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${philosophyImage.width}px`}
  
      />
        </div>
      </div>

      {/* History Column */}
      <div class="space-y-8 lg:pt-32">
        <div class="flex items-center gap-4">
          <div class="h-[1px] w-12 bg-primary" />
          <h2 class="text-sm font-bold uppercase tracking-[0.3em] text-primary">Nuestra Historia</h2>
        </div>
        <h3 class="text-3xl font-black leading-tight">De humildes comienzos a realizar sueños de otras personas</h3>
        <div class="space-y-10">
          {timelineEvents.map((event) => (
            <Timeline
              year={event.year}
              title={event.title}
              description={event.description}
              isFirst={event.isFirst}
            />
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
