---
import Container from '../shared/Container.astro';
import Icon from '../shared/Icon.astro';

// Obtenemos la ruta actual
const currentPath = Astro.url.pathname;

// Función para generar rutas absolutas correctas con base
function resolvePath(path: string) {
  return new URL(path, Astro.url).pathname;
}

const homeUrl = resolvePath('/pilligua/');
const projectsUrl = resolvePath('/pilligua/projects/');
const aboutUrl = resolvePath('/pilligua/about/');
const blogUrl = resolvePath('/pilligua/blog/');
const contactUrl = resolvePath('/pilligua/contact/');
---

<header class="fixed top-0 w-full z-50 bg-white/90 dark:bg-background-dark/90 backdrop-blur-md border-b border-slate-100 dark:border-slate-800">
  <Container class="h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href={homeUrl} class="flex items-center gap-3 group cursor-pointer">
      <div class="text-primary">
        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 48 48">
          <path d="M24 0.757355L47.2426 24L24 47.2426L0.757355 24L24 0.757355ZM21 35.7574V12.2426L9.24264 24L21 35.7574Z" />
        </svg>
      </div>
      <h1 class="text-xl font-black tracking-tighter uppercase">Muebles Pilligua</h1>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-10">
      <a 
        href={homeUrl} 
        class:list={[
          "text-sm font-semibold transition-colors",
          currentPath === homeUrl || currentPath === '/pilligua' || currentPath === '/pilligua/'
            ? "text-primary" 
            : "text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary"
        ]}
      >
        Inicio
      </a>
      <a 
        href={projectsUrl} 
        class:list={[
          "text-sm font-semibold transition-colors",
          currentPath.includes('/projects')
            ? "text-primary" 
            : "text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary"
        ]}
      >
        Nuestros Projectos
      </a>
      <a 
        href={aboutUrl} 
        class:list={[
          "text-sm font-semibold transition-colors",
          currentPath.includes('/about')
            ? "text-primary" 
            : "text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary"
        ]}
      >
        Nosotros
      </a>
      <a 
        href={blogUrl} 
        class:list={[
          "text-sm font-semibold transition-colors",
          currentPath.includes('/blog')
            ? "text-primary" 
            : "text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary"
        ]}
      >
        Blog
      </a>
    </nav>

    <!-- CTA -->
    <div class="flex items-center gap-4">
      <a 
        href={contactUrl} 
        class="bg-primary hover:bg-primary/90 text-white px-6 py-2.5 rounded text-sm font-bold uppercase tracking-wider transition-all flex items-center gap-2"
      >
        <Icon name="send" size={16} />
        <span>Inquire</span>
      </a>
      
      <!-- Mobile menu button -->
      <button class="md:hidden p-2 text-slate-600 dark:text-slate-400" aria-label="Open menu">
        <Icon name="menu" size={24} />
      </button>
    </div>
  </Container>
</header>