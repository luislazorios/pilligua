---
export interface Props {
  author?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: number;
}

const { author, pubDate, updatedDate, tags = [], readingTime } = Astro.props;
---

<div class="flex items-center flex-wrap gap-6 border-b border-outline-variant/30 pb-12">
  {author && (
    <div class="flex flex-col">
      <span class="font-label-caps text-[10px] text-text-muted uppercase tracking-widest">Author</span>
      <span class="font-body-md font-bold">{author}</span>
    </div>
  )}
  
  <div class="w-[1px] h-8 bg-outline-variant/30"></div>
  
  <div class="flex flex-col">
    <span class="font-label-caps text-[10px] text-text-muted uppercase tracking-widest">Published</span>
    <span class="font-body-md">
      {pubDate.toLocaleDateString('en-US', { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric' 
      })}
    </span>
  </div>
  
  {updatedDate && (
    <>
      <div class="w-[1px] h-8 bg-outline-variant/30"></div>
      <div class="flex flex-col">
        <span class="font-label-caps text-[10px] text-text-muted uppercase tracking-widest">Updated</span>
        <span class="font-body-md text-sm">
          {updatedDate.toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'short', 
            day: 'numeric' 
          })}
        </span>
      </div>
    </>
  )}
  
  {readingTime && (
    <>
      <div class="w-[1px] h-8 bg-outline-variant/30"></div>
      <div class="flex flex-col">
        <span class="font-label-caps text-[10px] text-text-muted uppercase tracking-widest">Read Time</span>
        <span class="font-body-md">{readingTime} min</span>
      </div>
    </>
  )}
  
  {tags.length > 0 && (
    <>
      <div class="w-[1px] h-8 bg-outline-variant/30 hidden md:block"></div>
      <div class="flex flex-wrap gap-2 ml-auto">
        {tags.map((tag) => (
          <span class="bg-surface-container px-4 py-1 font-label-caps text-[10px] uppercase tracking-widest rounded">
            {tag}
          </span>
        ))}
      </div>
    </>
  )}
</div>