---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import Icon from '../../components/shared/Icon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

// Calculate reading time (approximately)
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.ceil(wordCount / 200);

// Get related posts (excluding current) - moved to top level
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BlogLayout 
  title={post.data.title} 
  description={post.data.description}
  image={typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage?.src}
>
  <!-- ============================================================ -->
  <!-- HERO HEADER                                                  -->
  <!-- ============================================================ -->
  <header class="pt-24 w-full">
    <!-- Hero Image -->
    <div class="w-full h-[80vh] overflow-hidden relative group">
      <div 
        class="w-full h-full bg-cover bg-center transition-transform duration-1000 group-hover:scale-105"
        style={`background-image: url('${typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage?.src || 'https://lh3.googleusercontent.com/aida-public/AB6AXuCyKzs-TBqrhgP0855KJFNnbSM5RJfsG6Ik8Ky8Yp1FCP0nyCSyQZpPuBWWnFNkwoDuzD8zuZddpX-ysYVwybI7MHpmy_R4xfCVtuAXVcPClWvceLT-bz-5Myj6kmTimyivZOmNUcktHJCrZDREZ65JzVrAAR5tqCCXOvHzhfM7ffJSKXgMe47XwHsyFYSXvuCSllQqWyTYJj69xtIMyltFo_ydAhDT7UAlzW1LkRvhpPtvoGM7O3MsSw'}')`}
      >
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent"></div>
    </div>

    <!-- Post Metadata -->
    <div class="max-w-[800px] mx-auto px-6 -mt-32 relative z-10">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-6 block">
        {post.data.tags?.[0] || 'Architecture'} / Minimalism
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white mb-8">
        {post.data.title}
      </h1>
      
      <div class="flex items-center flex-wrap gap-6 border-b border-slate-200 dark:border-slate-800 pb-12">
        <div class="flex flex-col">
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Author</span>
          <span class="font-bold text-slate-900 dark:text-white">{post.data.author || 'Studio Alpha'}</span>
        </div>
        <div class="w-[1px] h-8 bg-slate-200 dark:bg-slate-800"></div>
        <div class="flex flex-col">
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Published</span>
          <span class="text-slate-900 dark:text-white">
            {post.data.pubDate.toLocaleDateString('en-US', { 
              month: 'short', 
              day: 'numeric', 
              year: 'numeric' 
            })}
          </span>
        </div>
        <div class="w-[1px] h-8 bg-slate-200 dark:bg-slate-800"></div>
        <div class="flex flex-col">
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Read Time</span>
          <span class="text-slate-900 dark:text-white">{readingTime} min</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ============================================================ -->
  <!-- ARTICLE CONTENT                                              -->
  <!-- ============================================================ -->
  <main class="py-24">
    <article class="max-w-[800px] mx-auto px-6 space-y-12">
      <!-- Prose Content with 3dinterior theme styling -->
      <div class="prose prose-lg dark:prose-invert max-w-none
        prose-headings:text-slate-900 dark:prose-headings:text-white
        prose-headings:font-black prose-headings:tracking-tight
        prose-h1:text-4xl prose-h1:md:text-5xl prose-h1:mb-8
        prose-h2:text-3xl prose-h2:md:text-4xl prose-h2:mt-12 prose-h2:mb-6
        prose-h3:text-2xl prose-h3:md:text-3xl prose-h3:mt-8 prose-h3:mb-4
        prose-p:text-slate-600 dark:prose-p:text-slate-400
        prose-p:leading-relaxed prose-p:mb-6
        prose-a:text-primary prose-a:no-underline hover:prose-a:underline
        prose-blockquote:border-l-[12px] prose-blockquote:border-primary
        prose-blockquote:bg-slate-50 dark:prose-blockquote:bg-slate-800/50
        prose-blockquote:p-8 prose-blockquote:md:p-12 prose-blockquote:my-12
        prose-blockquote:rounded
        prose-blockquote:text-slate-900 dark:prose-blockquote:text-white
        prose-blockquote:font-bold prose-blockquote:text-xl prose-blockquote:md:text-2xl
        prose-blockquote:italic prose-blockquote:leading-relaxed
        prose-figcaption:text-[10px] prose-figcaption:font-bold prose-figcaption:uppercase
        prose-figcaption:tracking-[0.2em] prose-figcaption:text-slate-500
        prose-figcaption:border-l-2 prose-figcaption:border-primary prose-figcaption:pl-4
        prose-img:rounded prose-img:shadow-lg
        prose-code:bg-slate-100 dark:prose-code:bg-slate-800
        prose-code:px-2 prose-code:py-1 prose-code:rounded
        prose-code:text-sm prose-code:font-mono
        prose-pre:bg-slate-100 dark:prose-pre:bg-slate-800
        prose-pre:p-6 prose-pre:rounded prose-pre:overflow-x-auto
        prose-pre:text-sm
        prose-hr:border-slate-200 dark:prose-hr:border-slate-800
        prose-hr:my-12
        prose-ul:text-slate-600 dark:prose-ul:text-slate-400
        prose-ol:text-slate-600 dark:prose-ol:text-slate-400
        prose-li:mb-2
        prose-table:text-slate-600 dark:prose-table:text-slate-400
        prose-th:bg-slate-100 dark:prose-th:bg-slate-800
        prose-th:font-bold prose-th:p-3
        prose-td:p-3 prose-td:border prose-td:border-slate-200 dark:prose-td:border-slate-800
      ">
        <Content />
      </div>

      <!-- Share & Tags Footer -->
      <div class="pt-12 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="flex gap-3">
          <button class="w-10 h-10 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-800 hover:bg-primary hover:border-primary hover:text-white transition-all">
            <Icon name="share" size={18} />
          </button>
          <button class="w-10 h-10 flex items-center justify-center rounded-full border border-slate-200 dark:border-slate-800 hover:bg-primary hover:border-primary hover:text-white transition-all">
            <Icon name="bookmark" size={18} />
          </button>
        </div>
        <div class="flex flex-wrap gap-2">
          {post.data.tags?.map((tag) => (
            <span class="bg-slate-100 dark:bg-slate-800 px-4 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-600 dark:text-slate-400 rounded">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </article>
  </main>

  <!-- ============================================================ -->
  <!-- RELATED ARTICLES                                             -->
  <!-- ============================================================ -->
  <section class="bg-slate-50 dark:bg-slate-900/30 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex justify-between items-end mb-16">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4 block">Keep Reading</span>
          <h2 class="text-4xl md:text-5xl font-black tracking-tight text-slate-900 dark:text-white">Related Articles</h2>
        </div>
        <a href="/blog" class="text-xs font-bold uppercase tracking-[0.2em] border-b-2 border-slate-900 dark:border-white pb-2 hover:text-primary hover:border-primary transition-all">
          View All Posts
        </a>
      </div>
      
      {relatedPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {relatedPosts.map((relatedPost) => (
            <a href={`/blog/${relatedPost.id}`} class="group cursor-pointer block">
              <div class="aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800 rounded mb-4">
                <img 
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
                  src={typeof relatedPost.data.heroImage === 'string' ? relatedPost.data.heroImage : relatedPost.data.heroImage?.src || 'https://lh3.googleusercontent.com/aida-public/AB6AXuCmvcIC_tp6mYvnhnpCQImpCULCisA5Qg85KY1ZTLlWF1-W9yfe4LMyO1frhaFJDm3vb_KgLl0i34RmcqeU2sRdHVGJmXyENyZ3A7-e2SIB07Vo4MHz5m-bh0FWxk1la1LTtonoIdiXkf4LXZneugHMdu370IKFDPCif4SkEC_SGSzONF0uVa5FZ_OxZ3V9_nwy0tiaEKhVSNVZlRvr8VYh2L8DEitxPm1ZnI7BziWX4ypbszLmtLE1iw'}
                  alt={relatedPost.data.title}
                />
              </div>
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 mb-2 block">
                {relatedPost.data.tags?.[0] || 'Architecture'} / {relatedPost.data.pubDate.getFullYear()}
              </span>
              <h3 class="text-xl font-black tracking-tight text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {relatedPost.data.title}
              </h3>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-slate-500 dark:text-slate-400 col-span-full text-center py-12">
          More articles coming soon.
        </p>
      )}
    </div>
  </section>
</BlogLayout>